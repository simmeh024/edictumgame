rules_version = '2';

// Edictum's world is public: anyone may read every nation, summary, space record and board post.
// A signed-in player (anonymous guests included) writes only their own documents:
//   nations/{uid}            the nation's shared half, {v: 1, j: <the record as JSON text>, reg, name, updatedAt, ts,
//                            pop, army, cl}: the last three are headline numbers the rules bound
//   stamps/{reg}/{key}/{uid} {t}: the server's time a save first carried a claim (c<cell>) or a find (s<site>)
//   nationx/{uid}            its private half, {j, t, ts}: what the region need not download at every save
//   summaries/{uid}          {reg, name, pop, t}: the headline the World page and region counts read
//   space/{uid}              {reg, name, t, j, ts}: Moon, Mars and belt data, only for nations that have any
//   boards/{reg}/posts/{id}  one post on a region's message board, {a: author uid, t: server time, x: text}
//   limits/{uid}             {p}: the time of the player's last post, which paces posting
//   reports/{id}             a player's report of another player's post or nation (admins read them)
//   rlimits/{uid}            {r}: the time of the player's last report, which paces reporting
//   support/{id}             a player's support ticket, {by, topic, x, t, st, name?, reg?, email?}, and an
//                            admin's answer when it is closed {reply?, ct, rby, exp}
//   slimits/{uid}            {s}: the time of the player's last support ticket, which paces them
//   bugs/{id}                a player's bug report, {by, ti, x, where, often, env, t, st, name?, reg?, img?}, and
//                            an admin's verdict {st, note, ut, uby}; bugImg/{id} its screenshot, blimits/{uid} {b}
//                            the time of the player's last report, which paces them
//   mod/{uid}                {hidden, removed, note, name, t, by}: an admin hid or removed a nation
//   bans/{uid}               {note, name, t, by}: an admin banned the account (it may save nothing)
//   staff/{uid}              {t}: this player is Edictum staff (an admin), so other players see it; only the
//                            admin themself can write it, and anyone may clear their own
//   fx/{reg}                 the region's currencies: value, Currency Prestige, rank and history summary
//   fxh/{id}                 one currency's daily history of value and prestige
//   fxs/{reg}                the currency job's own state (smoothing, volatility, a lease)
//   devnews/{id}             a development news post an admin wrote, {ti, h: its HTML, ex, as, by, nm, ...};
//                            players read the published ones (pub == true), admins also the drafts
//   devnews/{id}/posts/{id}  a comment on it, {a, t, x, nm, rg, fl?, st?}: written only by civic() (functions/),
//                            like the region boards, so the same checks and pacing apply
//   devnewsImg/{id}          an image in a post, {d: base64, m, w, h, by, t}, resized in the admin's browser
//   devnewsMeta/latest       {p: [{i, t}]}: the latest published posts, which every game listens to for its count
//   shop/{uid}               what the player owns from the Bureau of National Finery (the shop): written only by
//                            functions/shop.js from Paddle's verified reports, and read only by the player
//   finery/{uid}             {c: [cosmetic ids], reg}: the shop cosmetics a player owns, which every game checks
//                            before it shows one on another player's nation (written only by functions/shop.js)
//   presets/{uid}            {p: {1..5: {n, cz, fj?, t}}}: saved designs (fj: the flag, as JSON text), made while a member of the Chancery Club
//                            and kept (and loadable) after; only the player reads them
//   chron/{uid}/m/{month}    {d: {id: decision}, s: {day: snapshot}}: the Expanded National Chronicle, written while a
//                            member and read-only after; only the player reads it
// The currency documents are written only by the daily job (jobs/fx, with the Admin SDK, which these rules do
// not bind): no player, admin included, can set a currency's value or prestige from the game.
// The referee (functions/index.js) rolls battles on the server and alone writes referee/ (its signing key,
// and the public half every game reads) and armies/{uid} (an army's readiness, and its battles in log/).
// src/shim.js saves a nation, its summary and (when they changed) its private half and space record in one
// batch. These rules check that they agree and arrive together, that a nation is saved at most once a second
// and its space record at most once every 10 seconds (every player listens to space/), and that a player
// posts at most once every 20 seconds, only to their own region's board. Admins (custom claim
// admin == true, see tools/admin) may delete any post, read and clear reports, hide or remove nations
// and ban accounts.
// A player deleting their account removes their own documents. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }
    function region(r) {
      return r in ['meridian', 'frostmarch', 'northernpale', 'driftlands', 'silentmoors', 'wildwood',
        'saffron', 'hollow', 'ashen', 'ironsteppe', 'gilded', 'verdantbasin', 'coralreach', 'emberisles',
        'lanterncoast', 'jadeterraces', 'highcrags', 'cloudspine', 'obsidianrim', 'ambershallows',
        'sunkenkingdoms', 'mistral', 'stormwrack', 'longvalley', 'greywater', 'scatteredcrown'];
    }
    function label(s) {
      return s is string && s.size() <= 80;
    }
    function regionEnabled(r) {
      return isAdmin() || !exists(/databases/$(database)/documents/regionStatus/$(r))
        || get(/databases/$(database)/documents/regionStatus/$(r)).data.enabled != false;
    }
    // at most once per `secs` seconds: the document's previous server time is far enough back
    function paced(secs) {
      return !('ts' in resource.data) || request.time > resource.data.ts + duration.value(secs, 's');
    }
    // a moderator banned this account: it saves no nation, posts nothing and reports nothing
    function banned(uid) {
      return exists(/databases/$(database)/documents/bans/$(uid));
    }
    function nationAfter(uid) {
      return getAfter(/databases/$(database)/documents/nations/$(uid)).data;
    }

    // The nation's JSON text is capped well below Firestore's 1 MiB document limit;
    // src/shim.js refuses anything over 700,000 characters before it gets here.
    function validNation(d) {
      return d.keys().hasAll(['v', 'j', 'reg', 'name', 'updatedAt', 'ts'])
        && d.keys().hasOnly(['v', 'j', 'reg', 'name', 'updatedAt', 'ts', 'pop', 'army', 'cl', 'rev', 'storageV', 'permit', 'iq'])
        && (!('storageV' in d) || (d.storageV is int && d.storageV == 1))
        && (!('iq' in d) || (d.iq is int && d.iq == 1))
        && (!('rev' in d) || (d.rev is int && d.rev > 0))
        && d.v == 1
        && d.j is string && d.j.size() > 2 && d.j.size() <= 750000
        && region(d.reg) && label(d.name)
        && d.updatedAt is number
        && d.ts == request.time;
    }
    // The headline numbers beside the record, which every player's game holds the record to (the rules
    // cannot read the JSON): population in millions, army strength, and land claimed. Army and land are
    // bounded by the population, far above what the game produces.
    function headline(d) {
      return d.pop is number && d.pop >= 0 && d.pop <= 10000000
        && d.army is number && d.army >= 0 && d.army <= 60 * math.sqrt(d.pop + 0.1) + 1
        && d.cl is int && d.cl >= 0 && d.cl <= 200 + 6 * math.sqrt(d.pop) + d.pop / 100.0;
    }
    // ...and the population grows no faster than the game can make it since the last save: x1.35 a day
    // (its fastest growth is about x1.1), plus 3 million a day of migrants. A record that had none yet (from
    // before these numbers) may add them; once there they stay.
    function grows(d) {
      let days = (request.time.toMillis() - resource.data.ts.toMillis()) / 86400000.0;  // .0: an int division would round down to whole days
      return !('pop' in resource.data) || d.pop <= resource.data.pop * math.pow(1.35, days) + 3 * days + 0.0001;
    }
    function headlineUpdate(d) {
      return ('pop' in d) ? headline(d) && grows(d) : !('pop' in resource.data);
    }
    // Old nations migrate on their first new-client save. Once revisioned, an old or stale browser
    // cannot remove the revision, replay one, or skip one, even outside the adapter's transaction.
    function nextRevision(d) {
      return ('rev' in resource.data) ? ('rev' in d && d.rev == resource.data.rev + 1)
        : (!('rev' in d) || d.rev == 1);
    }
    // the summary written in the same batch says the same
    function summarised(uid, d) {
      let s = getAfter(/databases/$(database)/documents/summaries/$(uid)).data;
      return s.reg == d.reg && s.name == d.name && s.t == d.updatedAt && (!('pop' in d) || s.pop == d.pop);
    }
    // e, when present: the time the nation counts as active until, with a holiday after its last save
    // (holiday mode); at most a month (32 days) past t, so nobody can stay awake on it for longer
    function validSummary(d) {
      return d.keys().hasAll(['reg', 'name', 'pop', 't'])
        && d.keys().hasOnly(['reg', 'name', 'pop', 't', 'e'])
        && region(d.reg) && label(d.name)
        && d.pop is number && d.pop >= 0
        && d.t is number
        && (!('e' in d) || (d.e is number && d.e > d.t && d.e <= d.t + 2764800000));
    }
    function validPrivate(d) {
      return d.keys().hasAll(['j', 't', 'ts'])
        && d.keys().hasOnly(['j', 't', 'ts'])
        && d.j is string && d.j.size() >= 2 && d.j.size() <= 750000
        && d.t is number
        && d.ts == request.time;
    }
    function validSpace(d) {
      return d.keys().hasAll(['reg', 'name', 't', 'j', 'ts'])
        && d.keys().hasOnly(['reg', 'name', 't', 'j', 'ts'])
        && region(d.reg) && label(d.name)
        && d.t is number
        && d.j is string && d.j.size() <= 60000
        && d.ts == request.time;
    }
    function validPost(d) {
      return d.keys().hasAll(['a', 't', 'x'])
        && d.keys().hasOnly(['a', 't', 'x'])
        && d.a == request.auth.uid
        && d.t == request.time
        && d.x is string && d.x.size() > 0 && d.x.size() <= 400;
    }

    match /nations/{uid} {
      allow read: if true;
      allow create: if isSelf(uid) && permitted(uid, request.resource.data) && validNation(request.resource.data) && headline(request.resource.data)
        && regionEnabled(request.resource.data.reg)
        && (!('rev' in request.resource.data) || request.resource.data.rev == 1)
        && summarised(uid, request.resource.data) && !banned(uid);
      allow update: if isSelf(uid) && permitted(uid, request.resource.data) && validNation(request.resource.data) && headlineUpdate(request.resource.data)
        && regionEnabled(request.resource.data.reg) && regionEnabled(resource.data.reg)
        && (!('storageV' in resource.data) || ('storageV' in request.resource.data && request.resource.data.storageV == resource.data.storageV))
        // iq: the nation has held more than five waiting edicts (the Chancery Club's desk); from then on a build that
        // would cut the queue back to five may not save it
        && (!('iq' in resource.data) || request.resource.data.get('iq', 0) == resource.data.iq)
        && nextRevision(request.resource.data)
        && summarised(uid, request.resource.data) && paced(1) && !banned(uid);
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Opaque JSON needs server approval: rules compare the exact approved payload and revision.
    function permitted(uid, d) {
      let p = get(/databases/$(database)/documents/nationPermits/$(uid)/requests/$(d.permit)).data;
      return d.permit is string && p.exp > request.time && p.j == d.j && p.reg == d.reg
        && p.name == d.name && p.pop == d.pop && p.army == d.army && p.cl == d.cl
        && p.updatedAt == d.updatedAt && p.rev == d.rev
        && (!p.get('sensitive', false) || unmoderated(uid, p.nationGeneration));
    }
    function unmoderated(uid, generation) {
      return !exists(/databases/$(database)/documents/mod/$(uid))
        || (get(/databases/$(database)/documents/mod/$(uid)).data.get('hidden', false) == false
          && get(/databases/$(database)/documents/mod/$(uid)).data.get('removed', 0) < generation);
    }
    match /nationPermits/{uid}/requests/{id} { allow read, write: if false; }
    match /accountIdentity/{uid} { allow read, write: if false; }
    match /guestRecovery/{id} { allow read, write: if false; }
    match /recoveryLimits/{id} { allow read, write: if false; }
    // the address a player last played from, for the admin console only (functions/accounts.js, 'seen')
    match /accountSeen/{uid} { allow read, write: if false; }
    // the staff's private notes on a player, read and written only through the admin console (functions/admin.js)
    match /staffNotes/{uid} { allow read, write: if false; }
    // Discord sign-in (functions/discord.js): the application's secret, and which account holds each Discord account
    match /authConfig/{id} { allow read, write: if false; }
    match /discordLinks/{id} { allow read, write: if false; }
    match /assemblyRegions/{region}/{document=**} { allow read, write: if false; }

    // written only together with the nation (whose ts is this request's time), and agreeing with it
    match /summaries/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid) && validSummary(request.resource.data)
        && nationAfter(uid).ts == request.time
        && nationAfter(uid).reg == request.resource.data.reg
        && nationAfter(uid).name == request.resource.data.name
        && nationAfter(uid).updatedAt == request.resource.data.t;
      allow delete: if isSelf(uid) || isAdmin();
    }

    // the private half, written only with the nation it belongs to (so paced and refused to a banned
    // account with it)
    match /nationx/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid) && validPrivate(request.resource.data)
        && nationAfter(uid).ts == request.time
        && nationAfter(uid).updatedAt == request.resource.data.t;
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /space/{uid} {
      allow read: if true;
      allow create: if isSelf(uid) && validSpace(request.resource.data)
        && nationAfter(uid).ts == request.time
        && nationAfter(uid).reg == request.resource.data.reg
        && nationAfter(uid).name == request.resource.data.name;
      allow update: if isSelf(uid) && validSpace(request.resource.data)
        && nationAfter(uid).ts == request.time
        && nationAfter(uid).reg == request.resource.data.reg
        && nationAfter(uid).name == request.resource.data.name
        && paced(10);
      allow delete: if isSelf(uid) || isAdmin();
    }

    // a post goes to the board of the region the author's nation lives in, with limits/<uid> in the same batch
    match /boards/{reg}/posts/{pid} {
      allow read: if true;
      // New community topics use civic(), including shared eligibility and pacing checks.
      allow create: if false;
      allow delete: if signedIn() && (resource.data.a == request.auth.uid || isAdmin());
    }

    // every post, wherever it is, for a player deleting their account (posts where a == their uid)
    match /{path=**}/posts/{pid} {
      allow read: if true;
    }

    // Development news: only admins write posts, their images and the index. The HTML is cleaned in the
    // admin's browser and again in every reader's before it is shown.
    function validNews(d) {
      return d.keys().hasAll(['ti', 'h', 'ex', 'as', 'by', 'nm', 'pub', 't'])
        && d.keys().hasOnly(['ti', 'h', 'ex', 'as', 'by', 'nm', 'rl', 'fl', 'rg', 'pub', 't', 'ed', 'lk', 'im'])
        && d.ti is string && d.ti.size() > 0 && d.ti.size() <= 140
        && d.h is string && d.h.size() <= 100000
        && d.ex is string && d.ex.size() <= 300
        && d.as in ['staff', 'nation'] && d.by == request.auth.uid
        && label(d.nm) && d.nm.size() > 0
        && (!('rl' in d) || (d.rl is string && d.rl.size() <= 60))
        && (!('fl' in d) || (d.fl is string && d.fl.size() <= 4000))
        && (!('rg' in d) || region(d.rg))
        && d.pub is bool && d.t is number
        && (!('ed' in d) || d.ed is number)
        && (!('lk' in d) || d.lk is bool)
        && (!('im' in d) || (d.im is list && d.im.size() <= 40));
    }
    match /devnews/{pid} {
      allow read: if resource.data.pub == true || isAdmin();
      allow create, update: if isAdmin() && validNews(request.resource.data);
      allow delete: if isAdmin();
      // comments: posted and moderated through civic(); their author may delete one (deleting their account too)
      match /posts/{cid} {
        allow delete: if signedIn() && (resource.data.a == request.auth.uid || isAdmin());
      }
    }
    match /devnewsImg/{id} {
      allow read: if true;
      allow create: if isAdmin() && id.matches('[A-Za-z0-9]{20}')
        && request.resource.data.keys().hasOnly(['d', 'm', 'w', 'h', 'by', 't'])
        && request.resource.data.d is string && request.resource.data.d.size() > 0 && request.resource.data.d.size() <= 960000
        && request.resource.data.m in ['image/webp', 'image/jpeg', 'image/png', 'image/gif']
        && request.resource.data.w is int && request.resource.data.w > 0 && request.resource.data.w <= 4096
        && request.resource.data.h is int && request.resource.data.h > 0 && request.resource.data.h <= 4096
        && request.resource.data.by == request.auth.uid && request.resource.data.t is number;
      allow delete: if isAdmin();
    }
    match /devnewsMeta/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'latest'
        && request.resource.data.keys().hasOnly(['p'])
        && request.resource.data.p is list && request.resource.data.p.size() <= 30;
    }

    // A player reports a bug on the Report a bug page, with the game's technical details (env) and perhaps a
    // screenshot, sent in the same batch as bugImg/<the same id>. The player reads and may delete their own
    // reports; admins read all of them, set each one's state with a note the player reads, and delete them.
    function validBug(d) {
      return d.keys().hasAll(['by', 'ti', 'x', 'where', 'often', 'env', 't', 'st'])
        && d.keys().hasOnly(['by', 'ti', 'x', 'where', 'often', 'env', 't', 'st', 'name', 'reg', 'img'])
        && d.by == request.auth.uid && d.t == request.time && d.st == 'new'
        && d.ti is string && d.ti.size() > 0 && d.ti.size() <= 120
        && d.x is string && d.x.size() > 0 && d.x.size() <= 3000
        && d.where is string && d.where.size() <= 40
        && d.often in ['always', 'sometimes', 'once']
        && d.env is string && d.env.size() <= 3000
        && (!('name' in d) || label(d.name))
        && (!('reg' in d) || region(d.reg))
        && (!('img' in d) || d.img == true);
    }
    match /bugs/{bid} {
      allow create: if signedIn() && validBug(request.resource.data) && !banned(request.auth.uid)
        && getAfter(/databases/$(database)/documents/blimits/$(request.auth.uid)).data.b == request.time;
      allow read, delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'note', 'ut', 'uby'])
        && request.resource.data.st in ['new', 'seen', 'fixed', 'closed']
        && request.resource.data.ut == request.time && request.resource.data.uby == request.auth.uid
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 1000));
    }
    // a report's screenshot, made smaller in the player's browser: only together with a new report of theirs
    match /bugImg/{bid} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['d', 'm', 'w', 'h', 'by'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.d is string && request.resource.data.d.size() > 0 && request.resource.data.d.size() <= 700000
        && request.resource.data.m in ['image/webp', 'image/jpeg', 'image/png', 'image/gif']
        && request.resource.data.w is int && request.resource.data.w > 0 && request.resource.data.w <= 4096
        && request.resource.data.h is int && request.resource.data.h > 0 && request.resource.data.h <= 4096
        && !exists(/databases/$(database)/documents/bugs/$(bid))
        && getAfter(/databases/$(database)/documents/bugs/$(bid)).data.by == request.auth.uid
        && getAfter(/databases/$(database)/documents/bugs/$(bid)).data.get('img', false) == true;
      allow read, delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
    }
    // paces bug reports: one a minute
    match /blimits/{uid} {
      allow create: if isSelf(uid) && request.resource.data.keys().hasOnly(['b']) && request.resource.data.b == request.time;
      allow update: if isSelf(uid) && request.resource.data.keys().hasOnly(['b']) && request.resource.data.b == request.time
        && request.time > resource.data.b + duration.value(60, 's');
      allow delete: if isSelf(uid) && !existsAfter(/databases/$(database)/documents/nations/$(uid));
    }

    match /limits/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && request.resource.data.keys().hasOnly(['p']) && request.resource.data.p == request.time;
      allow update: if isSelf(uid) && request.resource.data.keys().hasOnly(['p']) && request.resource.data.p == request.time
        && request.time > resource.data.p + duration.value(20, 's');
      // only with the nation itself (deleting the account), or deleting it would undo the pacing
      allow delete: if isSelf(uid) && !existsAfter(/databases/$(database)/documents/nations/$(uid));
    }

    // A player reports another player's post or nation; only admins read and clear the reports. The
    // report keeps a copy of what was reported (name, x), in case it is changed or removed meanwhile.
    function validReport(d) {
      return d.keys().hasAll(['by', 'kind', 'target', 'reg', 'reason', 't'])
        && d.keys().hasOnly(['by', 'kind', 'target', 'post', 'reg', 'reason', 'note', 't', 'name', 'x'])
        && d.by == request.auth.uid && d.t == request.time
        && d.kind in ['post', 'nation']
        && d.target is string && d.target.size() > 0 && d.target.size() <= 128 && d.target != request.auth.uid
        && region(d.reg)
        && d.reason in ['name', 'content', 'harassment', 'spam', 'cheating', 'other']
        && (!('post' in d) || (d.post is string && d.post.size() <= 64))
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && (!('name' in d) || (d.name is string && d.name.size() <= 160))
        && (!('x' in d) || (d.x is string && d.x.size() <= 600));
    }
    match /reports/{rid} {
      allow create: if signedIn() && validReport(request.resource.data)
        && exists(/databases/$(database)/documents/nations/$(request.auth.uid)) && !banned(request.auth.uid)
        && getAfter(/databases/$(database)/documents/rlimits/$(request.auth.uid)).data.r == request.time;
      allow read, delete: if isAdmin();
    }
    // paces reporting: one report every 30 seconds (players with a nation report)
    match /rlimits/{uid} {
      allow create: if isSelf(uid) && request.resource.data.keys().hasOnly(['r']) && request.resource.data.r == request.time;
      allow update: if isSelf(uid) && request.resource.data.keys().hasOnly(['r']) && request.resource.data.r == request.time
        && request.time > resource.data.r + duration.value(30, 's');
      allow delete: if isSelf(uid) && !existsAfter(/databases/$(database)/documents/nations/$(uid));
    }

    // A player asks the game's team for help: one ticket, which an admin answers and closes. The player
    // reads and may delete their own tickets; admins read, answer and delete any. A closed ticket carries
    // exp, and Firestore's time-to-live policy (firestore.indexes.json) deletes it once that has passed.
    // Banned players may write too: a ticket is how they appeal.
    function validTicket(d) {
      return d.keys().hasAll(['by', 'topic', 'x', 't', 'st'])
        && d.keys().hasOnly(['by', 'topic', 'x', 't', 'st', 'name', 'reg', 'email'])
        && d.by == request.auth.uid && d.t == request.time && d.st == 'open'
        && d.topic in ['bug', 'account', 'play', 'other']
        && d.x is string && d.x.size() > 0 && d.x.size() <= 2000
        && (!('name' in d) || (d.name is string && d.name.size() <= 160))
        && (!('reg' in d) || region(d.reg))
        && (!('email' in d) || (d.email is string && d.email.size() <= 200));
    }
    match /support/{sid} {
      allow create: if signedIn() && validTicket(request.resource.data)
        && getAfter(/databases/$(database)/documents/slimits/$(request.auth.uid)).data.s == request.time;
      allow read, delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
      allow update: if isAdmin() && resource.data.st == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'reply', 'ct', 'rby', 'exp'])
        && request.resource.data.st == 'closed' && request.resource.data.ct == request.time
        && request.resource.data.rby == request.auth.uid
        && request.resource.data.exp is timestamp && request.resource.data.exp > request.time
        && (!('reply' in request.resource.data) || (request.resource.data.reply is string && request.resource.data.reply.size() <= 2000));
    }
    // paces support tickets: one a minute
    match /slimits/{uid} {
      allow create: if isSelf(uid) && request.resource.data.keys().hasOnly(['s']) && request.resource.data.s == request.time;
      allow update: if isSelf(uid) && request.resource.data.keys().hasOnly(['s']) && request.resource.data.s == request.time
        && request.time > resource.data.s + duration.value(60, 's');
      allow delete: if isSelf(uid) && !existsAfter(/databases/$(database)/documents/nations/$(uid));
    }

    // moderation: an admin hides a nation from the other players (until it is renamed, with rename), or records
    // that it was removed so its owner's browser drops its copy (every client reads this)
    function validMod(d) {
      return d.keys().hasAll(['hidden', 't', 'by']) && d.keys().hasOnly(['hidden', 'rename', 'removed', 'note', 'name', 't', 'by'])
        && d.hidden is bool && d.t is number && d.by == request.auth.uid
        && (!('rename' in d) || d.rename is bool)
        && (!('removed' in d) || d.removed is number)
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && (!('name' in d) || (d.name is string && d.name.size() <= 80));
    }
    match /mod/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() && validMod(request.resource.data);
      allow delete: if isAdmin();
    }

    // currencies: everyone reads values, prestige and history; nobody writes them but the daily job
    match /fx/{reg} {
      allow read: if true;
      allow write: if false;
    }
    match /fxh/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /fxs/{reg} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // bans: the banned player may read their own, so the game can tell them why
    match /bans/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['t', 'by']) && request.resource.data.keys().hasOnly(['note', 'name', 't', 'by'])
        && request.resource.data.t is number && request.resource.data.by == request.auth.uid
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 160));
      allow delete: if isAdmin();
    }

    // stamps: when a save first carries a claim on a free hex (c<cell>) or a site found (s<site>), the same
    // batch stamps it with the server's time, which settles races between nations (src/shim.js); nobody can
    // backdate one, and moving it later only harms its owner
    match /stamps/{reg}/{key}/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid) && region(reg) && key.matches('[cs][0-9]{1,6}')
        && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
      allow delete: if isSelf(uid) || isAdmin();
    }

    // staff: an admin's page marks its own player as staff, so every player can tell staff from players;
    // a claim cannot be forged, so neither can the mark. Rights taken away, the page clears it.
    match /staff/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid) && isAdmin()
        && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t is number;
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Availability defaults to enabled. Only the audited staff Cloud Function changes it.
    match /regionStatus/{reg} {
      allow read: if true;
      allow write: if false;
    }
    // Client-reported session diagnostics, separate from the actual server-confirmed nation save.
    match /saveHealth/{sid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/saveHealth/$(sid))
          || (resource.data.uid == request.auth.uid && request.time > resource.data.t + duration.value(10, 's')))
        && request.resource.data.keys().hasOnly(['uid', 'reg', 'device', 'status', 'revision', 'pending', 'error', 'conflicts', 't', 'expiresAt'])
        && region(request.resource.data.reg)
        && request.resource.data.device in ['Desktop', 'Mobile']
        && request.resource.data.status in ['synced', 'saving', 'offline']
        && request.resource.data.revision is int && request.resource.data.revision >= 0
        && request.resource.data.pending is bool
        && request.resource.data.conflicts is int && request.resource.data.conflicts >= 0 && request.resource.data.conflicts <= 1000000
        && request.resource.data.error is string && request.resource.data.error.size() <= 64
        && request.resource.data.t == request.time
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // The shop (functions/shop.js). What a player owns is written only there, from Paddle's verified reports; the
    // player reads their own, and every game reads the public projection of shop cosmetics.
    match /shop/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
    match /finery/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /shopCheckouts/{id} { allow read, write: if false; }
    match /shopTx/{id} { allow read, write: if false; }
    match /shopSubs/{id} { allow read, write: if false; }
    match /shopAdj/{id} { allow read, write: if false; }
    match /shopAcct/{uid} { allow read, write: if false; }
    match /shopCustomers/{id} { allow read, write: if false; }
    match /shopEvents/{id} { allow read, write: if false; }
    match /shopLimits/{uid} { allow read, write: if false; }
    // a member of the Chancery Club, by the paid-through time functions/shop.js keeps
    function member(uid) {
      let s = get(/databases/$(database)/documents/shop/$(uid));
      return s != null && s.data.get('vip', {}).get('until', 0) > request.time.toMillis();
    }
    function validPreset(x) {
      return x is map && x.keys().hasAll(['n', 'cz', 't']) && x.keys().hasOnly(['n', 'cz', 'fj', 't'])
        && x.n is string && x.n.size() <= 40 && x.cz is map && x.cz.size() <= 20 && x.t is number
        && (!('fj' in x) || (x.fj is string && x.fj.size() <= 20000));
    }
    function validPresets(d) {
      return d.keys().hasOnly(['p']) && d.p is map && d.p.keys().hasOnly(['1', '2', '3', '4', '5'])
        && (!('1' in d.p) || validPreset(d.p['1'])) && (!('2' in d.p) || validPreset(d.p['2']))
        && (!('3' in d.p) || validPreset(d.p['3'])) && (!('4' in d.p) || validPreset(d.p['4']))
        && (!('5' in d.p) || validPreset(d.p['5']));
    }
    // design presets: made and overwritten only by a member; kept, loadable and removable after
    match /presets/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && validPresets(request.resource.data) && member(uid);
      allow update: if isSelf(uid) && validPresets(request.resource.data)
        && (member(uid) || (request.resource.data.p.diff(resource.data.p).addedKeys().size() == 0
          && request.resource.data.p.diff(resource.data.p).changedKeys().size() == 0));
      allow delete: if isSelf(uid);
    }
    // the Expanded National Chronicle: private, kept by the player's game while a member, read-only after
    match /chron/{uid}/m/{month} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && member(uid) && month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['d', 's'])
        && (!('d' in request.resource.data) || request.resource.data.d is map)
        && (!('s' in request.resource.data) || request.resource.data.s is map);
      allow delete: if isSelf(uid);
    }
    match /adminAudit/{event} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // the referee's: every game reads the public half of its signing key (it checks the seal on each
    // conquest); a player reads their own army's readiness and battles, an admin anyone's. Only the
    // referee writes them.
    match /referee/{doc} {
      allow read: if doc == 'pub';
    }
    match /armies/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      match /log/{id} {
        allow read: if isSelf(uid) || isAdmin();
      }
    }
  }
}
